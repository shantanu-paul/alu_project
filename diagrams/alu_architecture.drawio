          <mxGeometry x="40" y="100" width="160" height="490" as="geometry" />
        </mxCell>
        <mxCell id="in_A" value="A [7:0]&#xa;(Operand A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontStyle=1;fontSize=12;" vertex="1" parent="input_grp">
