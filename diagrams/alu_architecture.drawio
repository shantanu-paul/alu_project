        <mxCell id="in_B" value="B [7:0]&#xa;(Operand B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontStyle=1;fontSize=12;" vertex="1" parent="input_grp">
