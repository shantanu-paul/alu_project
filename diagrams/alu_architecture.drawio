          <mxGeometry x="20" y="360" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Functional Core Sub-Blocks -->
        <!-- Block 1: Arithmetic Core -->
        <mxCell id="blk_arith" value="Arithmetic Core&#xa;--------------------------&#xa;0000: ADD (A + B)&#xa;0001: SUB (A - B)&#xa;0010: MUL (A * B)&#xa;0011: DIV (B != 0 ? A/B : 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=12;fontStyle=0;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Block 2: Shifter / Rotator Core -->
        <mxCell id="blk_shift" value="Shift &amp; Rotate Core&#xa;--------------------------&#xa;0100: LSL (A &lt;&lt; 1)&#xa;0101: LSR (A &gt;&gt; 1)&#xa;0110: ROL ({A[6:0], A[7]})&#xa;0111: ROR ({A[0], A[7:1]})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=12;fontStyle=0;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Block 3: Bitwise Logic Core -->
        <mxCell id="blk_logic" value="Bitwise Logic Core&#xa;--------------------------&#xa;1000: AND (A &amp; B)&#xa;1001: OR  (A | B)&#xa;1010: XOR (A ^ B)&#xa;1011: NOR (~(A | B))&#xa;1100: NAND (~(A &amp; B))&#xa;1101: XNOR (~(A ^ B))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;fontSize=12;fontStyle=0;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- Block 4: Comparator Core -->
        <mxCell id="blk_comp" value="Relational / Comparator Core&#xa;--------------------------&#xa;1110: GT ((A &gt; B) ? 8'd1 : 8'd0)&#xa;1111: EQ ((A == B) ? 8'd1 : 8'd0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=12;fontStyle=0;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="510" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- 16-to-1 Multiplexer (Output Selector) -->
